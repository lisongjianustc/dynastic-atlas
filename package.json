{
  "name": "dynastic-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "basemap": "node tools/build-basemap.mjs",
    "check:data": "mkdir -p .cache && esbuild tools/check.ts --bundle --platform=node --format=esm --outfile=.cache/check.mjs --log-level=error && node .cache/check.mjs",
    "check:points": "mkdir -p .cache && esbuild tools/points.ts --bundle --platform=node --format=esm --outfile=.cache/points.mjs --log-level=error && node .cache/points.mjs",
    "preview:svg": "mkdir -p .cache && esbuild tools/preview.ts --bundle --platform=node --format=esm --outfile=.cache/preview.mjs --log-level=error && node .cache/preview.mjs",
    "shot": "esbuild --help >/dev/null && bash tools/shot.sh",
    "verify": "npm run typecheck && npm run check:data && npm run check:points && npm run build",
    "regions": "node tools/gen-regions.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "description": "可连续查看的中国历代疆域地图：时间轴拖动，逐年看各国疆域与当年纪事",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lisongjianustc/dynastic-atlas.git"
  }
}
